@inject IPublicWebsiteService Store

@foreach (var article in articles)
{
    var url = Store.Route(article.Slug, "Article");
    <article class="news-card">
        <a href="@url" aria-label="@article.Title">
            @if (article.Image is { } image)
            {
                <img src="@image" alt="" loading="lazy" />
            }
            else
            {
                <Icon Name="cross" />
            }
        </a>
        <div class="news-card-body">
            <div class="news-meta">TIN TỨC <span>@article.PublishedAt?.ToString("dd.MM.yyyy")</span></div>
            <h3><a href="@url">@article.Title</a></h3>
            <p>@article.Summary</p>
            <a href="@url" class="text-link">Đọc bài viết <Icon Name="arrow" /></a>
        </div>
    </article>
}

@code {
    [Parameter] public int? Limit { get; set; }
    private IReadOnlyList<ArticleSummary> articles = [];
    protected override async Task OnParametersSetAsync() => articles = await Store.ListArticlesAsync(Limit);
}
