@inject NavigationManager Navigation

<a href="@LoginPath" data-enhance-nav="false">Đăng nhập để tiếp tục</a>

@code {
    private string LoginPath => "/admin/login?returnUrl=" + Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Navigation.NavigateTo(LoginPath, forceLoad: true);
    }
}
