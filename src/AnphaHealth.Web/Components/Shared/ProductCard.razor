<article class="product-card"><a class="product-image" href="/san-pham/@Item.Slug">@if (Item.Image is { } image) { <img src="@image" alt="@Item.Title — @Item.Brand" loading="lazy" /> } else { <Icon Name="@Item.Icon" /> }<span class="product-brand">@Item.Brand</span></a><div class="product-card-body"><span class="eyebrow">@Item.Category</span><h3><a href="/san-pham/@Item.Slug">@Item.Title</a></h3><p>@Item.Description</p><a class="text-link" href="/san-pham/@Item.Slug">Khám phá sản phẩm <Icon Name="arrow" /></a></div></article>
@code { [Parameter, EditorRequired] public PublicProduct Item { get; set; } = default!; }
