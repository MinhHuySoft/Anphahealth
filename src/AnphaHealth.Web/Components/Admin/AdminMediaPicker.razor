@using AnphaHealth.Web.Services.Contracts
@using AnphaHealth.Web.Services.Models
@inject IMediaService Media

<div class="admin-media-picker">
    @if (SelectedId.HasValue)
    {
        @if (selected is not null)
        {
            <div class="admin-selected-media"><img src="@selected.LocalPath" alt="@selected.AltText" /><span>@selected.FileName</span></div>
        }
        <div class="admin-picker-actions">
            <button class="admin-button admin-button-secondary" type="button" aria-expanded="@open" @onclick="ToggleAsync">Đổi ảnh bìa</button>
            <button class="admin-text-button" type="button" @onclick="ClearAsync">Gỡ ảnh bìa</button>
        </div>
    }
    else
    {
        <button class="admin-cover-placeholder" type="button" aria-expanded="@open" @onclick="ToggleAsync">
            <AdminIcon Name="image" />
            Chọn ảnh từ thư viện
        </button>
    }
    @if (open)
    {
        <section class="admin-picker-panel" aria-label="Chọn ảnh bìa">
            <div class="admin-picker-head"><strong>Thư viện ảnh</strong><button type="button" class="admin-icon-button" aria-label="Đóng thư viện" @onclick="() => open = false"><AdminIcon Name="close" /></button></div>
            <label class="admin-search">
                <span class="admin-sr-only">Tìm ảnh bìa</span>
                <AdminIcon Name="search" />
                <input type="search" @bind="search" @bind:after="SearchAsync" placeholder="Tên tệp…" />
            </label>
            <AdminAlert Message="@error" IsError="true" />
            @if (loading)
            {
                <p class="admin-loading">Đang tải ảnh…</p>
            }
            else if (result is { Items.Count: > 0 } data)
            {
                <div class="admin-picker-grid">
                    @foreach (var asset in data.Items)
                    {
                        <button type="button" class="@(asset.Id == SelectedId ? "is-selected" : "")" @onclick="() => SelectAsync(asset)" title="@asset.FileName">
                            <img src="@asset.LocalPath" alt="@asset.AltText" loading="lazy" />
                            <span>@asset.FileName</span>
                        </button>
                    }
                </div>
                <AdminPagination Total="@data.TotalCount" Page="@data.Page" PageSize="@data.PageSize" PageChanged="LoadAsync" />
            }
            else if (error is null)
            {
                <p class="admin-empty">Không có ảnh phù hợp.</p>
            }
        </section>
    }
</div>

@code {
    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<int?> SelectedIdChanged { get; set; }
    [Parameter] public string? InitialPath { get; set; }

    private bool open;
    private bool loading;
    private string search = "";
    private string? error;
    private MediaItem? selected;
    private PagedResult<MediaItem>? result;
    private int loadVersion;

    protected override void OnParametersSet()
    {
        if (SelectedId is int id && selected?.Id != id && !string.IsNullOrWhiteSpace(InitialPath))
            selected = new MediaItem(id, Path.GetFileName(InitialPath), InitialPath, "", 0, "", default);
        else if (SelectedId is null)
            selected = null;
    }

    private Task SearchAsync() => LoadAsync(1);

    private async Task ToggleAsync()
    {
        open = !open;
        if (open && result is null)
            await LoadAsync(1);
    }

    private async Task SelectAsync(MediaItem item)
    {
        selected = item;
        open = false;
        await SelectedIdChanged.InvokeAsync(item.Id);
    }

    private async Task ClearAsync()
    {
        selected = null;
        await SelectedIdChanged.InvokeAsync(null);
    }

    private async Task LoadAsync(int page)
    {
        var request = ++loadVersion;
        loading = true;
        error = null;
        try
        {
            var data = await Media.ListAsync(new CmsQuery(Search: search, Page: page, PageSize: 8));
            if (request == loadVersion)
                result = data;
        }
        catch (CmsException exception)
        {
            if (request == loadVersion)
                error = exception.Message;
        }
        finally
        {
            if (request == loadVersion)
                loading = false;
        }
    }
}
