@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="admin-alert @(IsError ? "is-error" : "is-success")" role="@(IsError ? "alert" : "status")">
        <AdminIcon Name="@(IsError ? "close" : "check")" />
        <span>@Message</span>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsError { get; set; }
}
