@inherits LayoutComponentBase
@inject IPublicWebsiteService Store
@inject ISiteSettingsService Settings
<a class="skip-link" href="#main-content">Chuyển đến nội dung</a>
<div class="topbar"><div class="container topbar-inner"><span class="topbar-intro">@site.Tagline</span><a href="@("tel:" + site.Phone.Replace(" ", ""))"><Icon Name="phone" /> @site.Phone</a><a href="@("mailto:" + site.Email)"><Icon Name="mail" /> @site.Email</a><span class="topbar-place"><Icon Name="pin" /> TP. Hồ Chí Minh</span></div></div>
<header class="site-header"><div class="container nav-inner">
<a href="/" class="brand" aria-label="Anpha Health - Trang chủ"><img src="@Store.Asset("logo-120px.png")" alt="Biểu trưng An Pha Health" width="55" height="60" /><span>ANPHA<span class="brand-health">HEALTH</span><small>THIẾT BỊ Y TẾ</small></span></a>
<button class="menu-toggle" @onclick="() => menuOpen = !menuOpen" aria-label="Mở menu" aria-expanded="@menuOpen"><Icon Name="menu" /></button>
<nav class="main-nav @(menuOpen ? "is-open" : "")" aria-label="Điều hướng chính" @onclick="() => menuOpen = false"><NavLink href="/" Match="NavLinkMatch.All">Trang chủ</NavLink><NavLink href="/gioi-thieu">Giới thiệu</NavLink><NavLink href="/san-pham">Sản phẩm</NavLink><NavLink href="/hoat-dong">Hoạt động</NavLink><NavLink href="/tin-tuc">Tin tức</NavLink><NavLink href="/tuyen-dung">Tuyển dụng</NavLink><NavLink href="/lien-he" class="mobile-contact">Liên hệ</NavLink></nav><a class="nav-contact button button-teal" href="/lien-he">Liên hệ tư vấn <Icon Name="arrow" /></a>
</div></header>
<main id="main-content">@Body</main>
<footer class="site-footer"><div class="container footer-grid">
<div class="footer-brand"><a class="brand" href="/"><img src="@Store.Asset("logo-120px.png")" alt="An Pha Health" width="55" height="60" /><span>ANPHA<span class="brand-health">HEALTH</span></span></a><p>Công ty TNHH Thương Mại TBYT An Pha.<br />Đồng hành cùng y khoa từ năm 2009.</p><a class="text-link" href="/gioi-thieu">Tìm hiểu về chúng tôi <Icon Name="arrow" /></a></div>
<div><h3>Khám phá</h3><a href="/gioi-thieu">Về Anpha Health</a><a href="/san-pham">Sản phẩm & thiết bị</a><a href="/tin-tuc">Tin tức</a><a href="/tuyen-dung">Cơ hội nghề nghiệp</a></div>
<div><h3>Lĩnh vực chuyên môn</h3><a href="/san-pham/fresenious-medicalcare-fmc">Lọc máu & lọc thận</a><a href="/san-pham/c-i-d">Can thiệp mạch</a><a href="/san-pham/medtronic">Tim phổi & van tim</a><a href="/san-pham/nagor-page">Cấy ghép ngực</a></div>
<div class="footer-contact"><h3>Kết nối với Anpha</h3><a class="footer-phone" href="@("tel:" + site.Phone.Replace(" ", ""))">@site.Phone</a><p>@site.Address</p><a href="@("mailto:" + site.Email)">@site.Email</a></div>
</div><div class="container footer-bottom"><span>© @site.SiteName</span><span><a href="/de-xuat">Phạm vi bản demo</a><a href="#main-content">Lên đầu trang ↑</a></span></div></footer>
<div id="blazor-error-ui" data-nosnippet>Có lỗi kết nối. <a href="." class="reload">Tải lại trang</a><span class="dismiss">×</span></div>

@code {
    private bool menuOpen;
    private SiteSettingsInput site = new();
    protected override async Task OnInitializedAsync() => site = await Settings.GetAsync();
}
