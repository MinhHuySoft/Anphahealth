@page "/"
@inject ContentStore Store
<PageTitle>Anpha Health — Đồng hành cùng y khoa</PageTitle>
<section class="home-hero" style="--hero-image:url('@Store.Asset("bigstock-Medicine-Doctor-Hand-Working-W-44541469_opt.jpg")')"><div class="container hero-inner">
<div class="hero-content"><span class="hero-kicker"><span></span> ANPHA HEALTH · TỪ NĂM 2009</span><h1>Thiết bị y tế tiên tiến.<br />Vì một cộng đồng<br /><em>khỏe mạnh hơn.</em></h1><p>Kết nối các giải pháp y khoa với đội ngũ y bác sĩ.<br class="desktop-break" /> Tận tâm phục vụ sức khỏe bằng chất lượng và uy tín.</p><div class="hero-actions"><a href="/san-pham" class="button button-white">Khám phá sản phẩm <Icon Name="arrow" /></a><a href="/gioi-thieu" class="button button-outline">Về Anpha Health</a></div></div>
<div class="hero-side-note"><span class="hero-orbit"><Icon Name="cross" /></span><span>Nhập khẩu & phân phối<br /><strong>Vật tư · Thiết bị y tế</strong></span></div><div class="hero-bottom"><span>CHẤT LƯỢNG LÀ NỀN TẢNG. UY TÍN LÀ CAM KẾT.</span><a href="#linh-vuc">Khám phá Anpha <span>↓</span></a></div>
</div></section>
<section class="specialty-strip" id="linh-vuc"><div class="container specialty-grid">@foreach (var p in Store.Products.Where(x => x.Primary)) { <a href="/san-pham/@p.Slug"><Icon Name="@p.Icon" /><span><small>GIẢI PHÁP CHUYÊN BIỆT</small><strong>@p.Category</strong></span><Icon Name="arrow" /></a> }</div></section>
<section class="brand-strip"><div class="container brand-strip-inner"><span>CÁC THƯƠNG HIỆU<br /><strong>TRONG DANH MỤC PHÂN PHỐI</strong></span><img src="@Store.Asset("fresenius-medical-care-logo-1000x226.png")" alt="Fresenius Medical Care" /><img src="@Store.Asset("Alvimedica-Logo_PMS165.png")" alt="Alvimedica" /><img src="@Store.Asset("Medtronic_Logo.svg_.png")" alt="Medtronic" /><img src="@Store.Asset("NAGOR_CMYK.png")" alt="Nagor" /></div></section>
<section class="section about-home"><div class="container about-grid"><div class="about-visual"><img src="@Store.Asset("banner-gt.png")" alt="Hình ảnh y khoa trên website Anpha Health" loading="lazy" /><div class="since-card"><strong>2009</strong><span>Năm thành lập<br />Anpha Health</span></div><div class="about-visual-caption"><Icon Name="heart" /><span>Trách nhiệm với cộng đồng.<br /><strong>Khách hàng là trọng tâm.</strong></span></div></div><div class="about-copy"><span class="eyebrow">VỀ ANPHA HEALTH</span><h2>Kết nối công nghệ y khoa.<br />Trao gửi niềm tin.</h2><p class="lead">Nhà nhập khẩu và phân phối máy móc, vật tư, thiết bị y tế tại Việt Nam.</p><p>Thành lập từ năm 2009, Công ty TNHH Thương Mại TBYT An Pha khởi đầu trong lĩnh vực thẩm mỹ và mở rộng sang các mặt hàng vật tư y tế kỹ thuật cao từ cuối năm 2014.</p><div class="value-lines"><div><Icon Name="check" /> Hợp tác lâu dài và toàn diện với giới y khoa</div><div><Icon Name="check" /> Chất lượng tốt với chi phí phù hợp</div><div><Icon Name="check" /> Trung thực, uy tín, học hỏi và sáng tạo</div></div><a href="/gioi-thieu" class="button button-navy">Câu chuyện của chúng tôi <Icon Name="arrow" /></a></div></div></section>
<section class="section section-tint"><div class="container"><div class="section-heading"><div><span class="eyebrow">DANH MỤC SẢN PHẨM</span><h2>Giải pháp cho từng<br />lĩnh vực chuyên môn.</h2></div><div><p>Khám phá danh mục thiết bị và vật tư y tế<br />từ các thương hiệu trong danh mục Anpha.</p><a class="text-link" href="/san-pham">Xem tất cả sản phẩm <Icon Name="arrow" /></a></div></div><div class="product-grid">@foreach (var p in Store.Products.Where(x => x.Primary)) { <ProductCard Item="p" /> }</div></div></section>
<section class="commitment"><div class="container commitment-inner"><div class="commitment-icon"><Icon Name="shield" /></div><div><span class="eyebrow light">SỨ MỆNH CỦA CHÚNG TÔI</span><h2>Phục vụ bệnh nhân bằng chất lượng.<br />Phát triển bằng giá trị cho cộng đồng.</h2></div><a href="/lien-he" class="button button-white">Kết nối với Anpha <Icon Name="arrow" /></a></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">TIN TỨC & CHIA SẺ</span><h2>Góc thông tin Anpha.</h2></div><a class="text-link" href="/tin-tuc">Tất cả bài viết <Icon Name="arrow" /></a></div><div class="news-grid"><NewsCards /></div></div></section>
