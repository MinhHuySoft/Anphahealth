@page "/de-xuat"
@inject IPublicWebsiteService Store
<PageTitle>Phạm vi demo & đề xuất triển khai — Anpha Health</PageTitle>
<PageHero Eyebrow="Bản trình duyệt giao diện" Title="Một diện mạo mới cho Anpha Health." Description="Nội dung Anpha Health · Hướng giao diện Chemlabs · Công nghệ Blazor Web App" />
<section class="section"><div class="container"><div class="proposal-intro"><div class="stat-card"><strong>177</strong><span>URL công khai được lưu</span></div><div class="stat-card"><strong>30</strong><span>Page & post từ WordPress</span></div><div class="stat-card"><strong>127</strong><span>Tệp media lưu cục bộ</span></div><div class="stat-card"><strong>4</strong><span>Biến thể trang chủ Chemlabs</span></div></div><span class="eyebrow">LỰA CHỌN GIAO DIỆN</span><h2>Chọn đúng mẫu cho từng loại nội dung.</h2><p>Chemlabs có 29 trang HTML truy cập được: 4 trang chủ và 25 trang con. Hướng Home Supplies phù hợp với mô hình phân phối thiết bị của Anpha, kết hợp các khối của Home Main cho trang giới thiệu doanh nghiệp.</p><div class="table-wrap"><table class="scope-table"><thead><tr><th>Trang Anpha</th><th>Tham chiếu Chemlabs</th><th>Phạm vi bản demo</th><th>Xem giao diện</th></tr></thead><tbody>@foreach (var row in Rows) { <tr><td>@row.Name</td><td>@row.Template</td><td>@row.Scope</td><td><a href="@row.Url">Mở trang →</a></td></tr> }</tbody></table></div><h2>Phạm vi để lập báo giá triển khai</h2><div class="values-grid"><article><Icon Name="cross" /><h3>Giao diện</h3><p>8 loại trang chính, dùng chung header, footer, danh mục, bài viết và các thành phần responsive.</p></article><article><Icon Name="shield" /><h3>Quản trị</h3><p>Đề xuất bổ sung CMS quản lý sản phẩm, tin tức, tuyển dụng, hoạt động, media và thông tin liên hệ.</p></article><article><Icon Name="mail" /><h3>Tích hợp</h3><p>Gửi email liên hệ, chống spam, bản đồ, quản lý yêu cầu và thông báo cần được chốt khi báo giá.</p></article><article><Icon Name="pulse" /><h3>Chuyển đổi</h3><p>Di chuyển nội dung, duyệt thông tin cũ, chuyển hướng URL, SEO và triển khai hosting .NET.</p></article></div><div class="proposal-note"><h3>Hiện trạng cần khách hàng xác nhận</h3><p>Các mục tuyển dụng, chính sách, ứng tuyển, hình ảnh công ty và hoạt động xã hội ở nguồn vẫn là “Đang cập nhật”. Các bài viết hiện có từ năm 2016. Địa chỉ, thông tin hãng, thông số và giá lịch sử cần được duyệt lại trước khi xuất bản.</p><p>Website và CMS dùng cơ sở dữ liệu SQL Server. Yêu cầu liên hệ được lưu để xử lý trong CMS.</p></div><h2>Bản đồ nội dung đã thu thập</h2><p>177 URL gồm trang nội dung, trang đính kèm, taxonomy, tác giả và trang thành phần. Không tương đương 177 trang thiết kế riêng. 4 liên kết lỗi của nguồn được ghi trong báo cáo crawl.</p><label class="search-field"><Icon Name="search" /><input aria-label="Tìm trang đã crawl" @bind="query" @bind:event="oninput" placeholder="Tìm trong bản lưu nội dung..." /></label><div class="archive-list" style="margin-top:25px">@foreach (var p in pages.Where(x => ($"{x.Title} {x.Slug}").Contains(query, StringComparison.CurrentCultureIgnoreCase))) { <a href="@Store.Route(p.Slug, p.Kind)"><span>@p.Title</span><small>/@p.Slug</small></a> }</div></div></section>
@code {
    string query = "";
    private IReadOnlyList<ArchiveEntry> pages = [];
    protected override async Task OnInitializedAsync() => pages = await Store.ListArchiveAsync();
    record ScopeRow(string Name, string Template, string Scope, string Url);
    ScopeRow[] Rows = [
        new("Trang chủ", "home-supllies.html + index.html", "Hero, 4 lĩnh vực, thương hiệu, giới thiệu, sản phẩm, tin tức", "/"),
        new("Giới thiệu", "about-us.html + why-us.html", "Hành trình, tầm nhìn, sứ mệnh, văn hóa, giá trị", "/gioi-thieu"),
        new("Danh mục sản phẩm", "supplies.html", "8 mục hiển thị, tìm kiếm, lọc theo lĩnh vực", "/san-pham"),
        new("Chi tiết sản phẩm", "supplies-single.html + tests-single-test.html", "Thông tin nguồn, ảnh, nhóm sản phẩm, yêu cầu tư vấn", "/san-pham/fresenious-medicalcare-fmc"),
        new("Tin tức & chi tiết", "blog.html + blog-single-post.html", "2 bài viết hiện có và nội dung chi tiết", "/tin-tuc"),
        new("Hoạt động", "research-grid.html", "2 nhóm nội dung, giữ trạng thái đang cập nhật", "/hoat-dong"),
        new("Tuyển dụng", "careers.html", "Tin tuyển dụng, chính sách, ứng tuyển", "/tuyen-dung"),
        new("Liên hệ", "contact-us.html", "Địa chỉ, điện thoại, email, form lưu yêu cầu vào CMS", "/lien-he")
    ];
}
