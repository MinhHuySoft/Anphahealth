@page "/lien-he"
@inject IPublicWebsiteService Website
@inject ISiteSettingsService Settings
@inject IInquiryService Inquiries
@inject ILogger<Contact> Logger

<PageTitle>Liên hệ — Anpha Health</PageTitle>
<PageHero Eyebrow="Liên hệ" Title="Kết nối với Anpha Health" Description="Tư vấn thiết bị, vật tư y tế và cơ hội hợp tác." />

<section class="section">
    <div class="container contact-grid">
        <div>
            <span class="eyebrow">THÔNG TIN LIÊN HỆ</span>
            <h2>Thông tin công ty</h2>
            <div class="contact-info">
                <Icon Name="pin" /><div><h3>Địa chỉ công ty</h3><p>@site.Address</p></div>
            </div>
            <div class="contact-info">
                <Icon Name="pin" /><div><h3>Văn phòng</h3><p>@site.OfficeAddress</p></div>
            </div>
            <div class="contact-info">
                <Icon Name="phone" />
                <div>
                    <h3>Điện thoại & email</h3>
                    <a href="@("tel:" + site.Phone.Replace(" ", ""))">@site.Phone</a><br />
                    <a href="@("mailto:" + site.Email)">@site.Email</a>
                    @if (!string.IsNullOrEmpty(site.Fax)) { <p>Fax: @site.Fax</p> }
                </div>
            </div>
        </div>
        <div class="contact-form-card">
            <h2>Yêu cầu tư vấn</h2>
            @if (submitted)
            {
                <div class="form-success" role="status">
                    <Icon Name="check" />
                    <h3>Anpha đã nhận được yêu cầu</h3>
                    <p>Cảm ơn @model.Name. Chúng tôi sẽ liên hệ qua thông tin bạn cung cấp.</p>
                    <button class="button button-navy" @onclick="Reset">Gửi yêu cầu khác</button>
                </div>
            }
            else
            {
                @if (error is not null) { <p role="alert" class="validation-message">@error</p> }
                <EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="contact">
                    <DataAnnotationsValidator />
                    <div class="form-row">
                        <label>Họ và tên *<InputText @bind-Value="model.Name" maxlength="120" autocomplete="name" /><ValidationMessage For="() => model.Name" /></label>
                        <label>Email *<InputText @bind-Value="model.Email" maxlength="254" type="email" autocomplete="email" /><ValidationMessage For="() => model.Email" /></label>
                    </div>
                    <div class="form-row">
                        <label>Số điện thoại<InputText @bind-Value="model.Phone" maxlength="40" type="tel" autocomplete="tel" /><ValidationMessage For="() => model.Phone" /></label>
                        <label>Lĩnh vực quan tâm
                            <InputSelect @bind-Value="model.Interest">
                                <option value="Tư vấn chung">Tư vấn chung</option>
                                @foreach (var category in products.Select(product => product.Category).Distinct())
                                {
                                    <option value="@category">@category</option>
                                }
                            </InputSelect>
                        </label>
                    </div>
                    <label>Nội dung yêu cầu *<InputTextArea @bind-Value="model.Message" maxlength="4000" rows="4" /><ValidationMessage For="() => model.Message" /></label>
                    <button class="button button-teal" type="submit" disabled="@saving">@(saving ? "Đang gửi…" : "Gửi yêu cầu") <Icon Name="arrow" /></button>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "sanpham")] public string? ProductSlug { get; set; }

    private SiteSettingsInput site = new();
    private IReadOnlyList<PublicProduct> products = [];
    private ContactInput model = new();
    private bool submitted;
    private bool saving;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        site = await Settings.GetAsync();
        products = await Website.ListProductsAsync();
    }

    protected override void OnParametersSet() => Reset();

    private void Reset()
    {
        model = new ContactInput
        {
            Interest = products.FirstOrDefault(item => item.Slug == ProductSlug)?.Category ?? "Tư vấn chung"
        };
        submitted = false;
        error = null;
    }

    private async Task SubmitAsync()
    {
        if (saving || submitted)
            return;

        saving = true;
        error = null;
        try
        {
            await Inquiries.CreateAsync(model);
            submitted = true;
        }
        catch (CmsException exception)
        {
            error = exception.Message;
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException exception)
        {
            Logger.LogError(exception, "Could not save a contact request");
            error = "Chưa lưu được yêu cầu. Vui lòng thử lại sau.";
        }
        finally
        {
            saving = false;
        }
    }
}
