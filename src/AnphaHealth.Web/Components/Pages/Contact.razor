@page "/lien-he"
@using System.ComponentModel.DataAnnotations
@inject ContentStore Store
<PageTitle>Liên hệ — Anpha Health</PageTitle>
<PageHero Eyebrow="Liên hệ" Title="Bắt đầu một kết nối tốt đẹp." Description="Anpha sẵn sàng lắng nghe nhu cầu của bạn." />
<section class="section"><div class="container contact-grid"><div><span class="eyebrow">THÔNG TIN LIÊN HỆ</span><h2>Hãy kết nối<br />với chúng tôi.</h2><p>Liên hệ Anpha để tìm hiểu danh mục thiết bị, vật tư y tế và cơ hội hợp tác.</p><div class="contact-info"><Icon Name="pin" /><div><h3>Địa chỉ công ty</h3><p>881 Trường Chinh, P. Tây Thạnh,<br />Q. Tân Phú, TP. Hồ Chí Minh, Việt Nam</p></div></div><div class="contact-info"><Icon Name="pin" /><div><h3>Văn phòng</h3><p>51/8 Thành Thái, P. 14, Q. 10,<br />TP. Hồ Chí Minh, Việt Nam</p></div></div><div class="contact-info"><Icon Name="phone" /><div><h3>Điện thoại & email</h3><a href="tel:02839778936">028 3977 8936</a><br /><a href="mailto:lienhe@anphahealth.com">lienhe@anphahealth.com</a><p>Fax: 028 3977 8836</p></div></div></div><div class="contact-form-card"><span class="eyebrow">YÊU CẦU TƯ VẤN</span><h2>Chúng tôi có thể<br />hỗ trợ gì cho bạn?</h2>@if (previewed) { <div class="form-success" role="status"><Icon Name="check" /><h3>Yêu cầu đã sẵn sàng để xem trước</h3><p>Cảm ơn @model.Name. Đây là bản demo giao diện; yêu cầu chưa được gửi đến Anpha.</p><dl><dt>Lĩnh vực quan tâm</dt><dd>@model.Interest</dd><dt>Nội dung</dt><dd>@model.Message</dd></dl><button class="button button-navy" @onclick="() => previewed = false">Chỉnh sửa yêu cầu</button></div> } else { <EditForm Model="model" OnValidSubmit="Preview" FormName="contact"><DataAnnotationsValidator /><div class="form-row"><label>Họ và tên *<InputText @bind-Value="model.Name" placeholder="Họ và tên của bạn" autocomplete="name" /><ValidationMessage For="() => model.Name" /></label><label>Email *<InputText @bind-Value="model.Email" placeholder="email@congty.vn" type="email" autocomplete="email" /><ValidationMessage For="() => model.Email" /></label></div><div class="form-row"><label>Số điện thoại<InputText @bind-Value="model.Phone" type="tel" placeholder="Số điện thoại liên hệ" autocomplete="tel" /></label><label>Lĩnh vực quan tâm<InputSelect @bind-Value="model.Interest"><option value="Tư vấn chung">Tư vấn chung</option>@foreach (var c in Store.Products.Where(x => x.Primary)) { <option value="@c.Category">@c.Category</option> }</InputSelect></label></div><label>Nội dung yêu cầu *<InputTextArea @bind-Value="model.Message" placeholder="Chia sẻ nhu cầu của bạn..." rows="4" /><ValidationMessage For="() => model.Message" /></label><p class="form-demo-note">Bản demo chỉ hiển thị xác nhận, thông tin không được gửi đi.</p><button class="button button-teal" type="submit">Xem trước yêu cầu <Icon Name="arrow" /></button></EditForm> }</div></div></section>
@code {
    [SupplyParameterFromQuery(Name = "sanpham")] public string? ProductSlug { get; set; }
    ContactModel model = new(); bool previewed;
    protected override void OnParametersSet() { if (Store.Products.FirstOrDefault(x => x.Slug == ProductSlug) is { } product) model.Interest = product.Category; }
    void Preview() => previewed = true;
    public class ContactModel {
        [Required(ErrorMessage = "Vui lòng nhập họ và tên.")] public string Name { get; set; } = "";
        [Required(ErrorMessage = "Vui lòng nhập email."), EmailAddress(ErrorMessage = "Email chưa hợp lệ.")] public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Interest { get; set; } = "Tư vấn chung";
        [Required(ErrorMessage = "Vui lòng nhập nội dung yêu cầu.")] public string Message { get; set; } = "";
    }
}
