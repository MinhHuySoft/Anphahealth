@page "/noi-dung/{**Slug}"
@inject IPublicWebsiteService Store
@inject NavigationManager Navigation
@if (content is { } contentPage)
{
    <PageTitle>@contentPage.Title — Anpha Health</PageTitle><PageHero Eyebrow="Nội dung website hiện tại" Title="@contentPage.Title" />
    <section class="section"><div class="container article-layout"><article><div class="prose source-content">@((MarkupString)contentPage.Html)</div>@if (contentPage.Url is { } source) { <p class="source-note"><a href="@source" target="_blank" rel="noopener noreferrer">Xem nguồn nội dung</a></p> }</article><aside class="help-card"><h3>Khám phá Anpha Health</h3><p>Danh mục sản phẩm, thông tin công ty và liên hệ.</p><a href="@(Store.Route(contentPage.Slug, contentPage.Kind).StartsWith("/noi-dung") ? "/" : Store.Route(contentPage.Slug, contentPage.Kind))" class="button button-white">@(Store.Route(contentPage.Slug, contentPage.Kind).StartsWith("/noi-dung") ? "Trang chủ" : "Xem giao diện mới") <Icon Name="arrow" /></a></aside></div></section>
} else { <PageHero Title="Nội dung chưa có trong bản lưu" /><section class="section"><div class="container"><p>Liên kết này chưa có dữ liệu khả dụng từ website gốc.</p><a class="button button-navy" href="/">Về trang chủ <Icon Name="arrow" /></a></div></section> }

@code {
    [Parameter] public string? Slug { get; set; }
    private PublicPage? content;

    protected override async Task OnParametersSetAsync()
    {
        content = await Store.GetPageAsync(Slug ?? "home");
        if (content is null) Navigation.NotFound();
        else if (content.Kind == "Guide") Navigation.NavigateTo(Store.Route(content.Slug, content.Kind), replace: true);
    }
}
