@page "/gioi-thieu"
@inject IPublicWebsiteService Website
@inject NavigationManager Navigation

@if (page is { } about && document is { } profile)
{
    var pageTitle = about.Title == "Giới thiệu" ? "Về Anpha Health" : about.Title;

    <PageTitle>@pageTitle — Anpha Health</PageTitle>

    <section class="about-hero" aria-labelledby="about-title">
        <div class="container about-hero-inner">
            <div class="about-hero-content">
                <nav class="about-breadcrumb" aria-label="Đường dẫn">
                    <a href="/">Trang chủ</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page">Giới thiệu</span>
                </nav>
                <h1 id="about-title">@pageTitle</h1>
                <p>@(string.IsNullOrWhiteSpace(about.Summary)
                        ? "Nhập khẩu và phân phối thiết bị, vật tư y tế tại Việt Nam."
                        : about.Summary)</p>
                <a class="button about-hero-action" href="@(specialties.Count > 0 ? "/gioi-thieu#linh-vuc-phan-phoi" : "/san-pham")">
                    Khám phá lĩnh vực phân phối <Icon Name="arrow" />
                </a>
            </div>
        </div>
        <img class="about-cover" src="@(about.FeaturedImage ?? Website.Asset(AboutDocument.DefaultCover))" alt="" fetchpriority="high" />
    </section>

    @if (!string.IsNullOrWhiteSpace(profile.Introduction))
    {
        <section class="about-section" aria-labelledby="about-story-title">
            <div class="container about-story">
                <div class="about-story-heading">
                    <h2 id="about-story-title">Hành trình phát triển</h2>
                    @if (profile.HasFoundingYear || profile.HasExpansionYear)
                    {
                        <dl class="about-milestones">
                            @if (profile.HasFoundingYear)
                            {
                                <div><dt>2009</dt><dd>Thành lập Anpha Health</dd></div>
                            }
                            @if (profile.HasExpansionYear)
                            {
                                <div><dt>2014</dt><dd>Mở rộng danh mục vật tư y tế</dd></div>
                            }
                        </dl>
                    }
                </div>
                <div class="about-story-copy prose">@((MarkupString)profile.Introduction)</div>
            </div>
        </section>
    }

    @if (specialties.Count > 0)
    {
        <section id="linh-vuc-phan-phoi" class="about-section about-specialties" aria-labelledby="about-specialties-title">
            <div class="container">
                <div class="about-section-heading">
                    <h2 id="about-specialties-title">Lĩnh vực phân phối</h2>
                    <a class="text-link" href="/san-pham">Xem danh mục sản phẩm <Icon Name="arrow" /></a>
                </div>
                <div class="about-specialty-grid">
                    @foreach (var specialty in specialties)
                    {
                        <a href="/san-pham/@specialty.Slug" class="about-specialty-card">
                            <span class="about-specialty-icon"><Icon Name="@specialty.Icon" /></span>
                            <h3>@specialty.Category</h3>
                            <span class="about-specialty-brand">@specialty.Brand</span>
                            <span class="about-specialty-arrow"><Icon Name="arrow" /></span>
                        </a>
                    }
                </div>
            </div>
        </section>
    }

    @if (profile.Sections.Count > 0)
    {
        <section class="about-section" aria-labelledby="about-values-title">
            <div class="container">
                <div class="about-section-heading"><h2 id="about-values-title">Định hướng & giá trị</h2></div>
                <div class="about-values-grid">
                    @foreach (var item in profile.Sections)
                    {
                        <div class="about-value-card">
                            <h3>@item.Title</h3>
                            <div class="about-value-copy prose">@((MarkupString)item.Html)</div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <div class="container about-contact-wrap">
        <section class="about-contact" aria-labelledby="about-contact-title">
            <div>
                <h2 id="about-contact-title">Hợp tác cùng Anpha Health</h2>
                <p>Trao đổi với chúng tôi về thiết bị, vật tư y tế và nhu cầu phân phối.</p>
            </div>
            <a class="button button-white" href="/lien-he">Liên hệ với Anpha <Icon Name="arrow" /></a>
        </section>
    </div>
}

@code {
    private PublicPage? page;
    private AboutDocument? document;
    private IReadOnlyList<PublicProduct> specialties = [];

    protected override async Task OnInitializedAsync()
    {
        var pageTask = Website.GetPageAsync("gioi-thieu", "Page");
        var productsTask = Website.ListProductsAsync();
        await Task.WhenAll(pageTask, productsTask);

        page = await pageTask;
        if (page is null)
        {
            Navigation.NotFound();
            return;
        }

        specialties = (await productsTask).Where(product => product.Primary)
            .DistinctBy(product => product.Category)
            .ToArray();
        document = AboutDocument.Read(page.Html, specialties.Count > 0);
    }
}
